SECRET_KEY=change-this-to-a-random-secret-key
DATABASE_URL=sqlite:///python_job_scheduler.db
ADMIN_EMAIL=admin@example.com
# Required before the first run: a strong password used to seed the admin
# account. (The app refuses to start with this blank or a common placeholder
# when no admin account exists yet.)
ADMIN_PASSWORD=
TIMEZONE=America/New_York
SMTP_SERVER=smtp.test.com
SMTP_PORT=587
SMTP_USERNAME=smtpusername
SMTP_PASSWORD=smtppassword
SMTP_FROM=noreply@example.com
EMAIL_ENABLED=true
# Web server (never enable FLASK_DEBUG in production - the Werkzeug
# debugger allows remote code execution, and the reloader would also
# start the scheduler twice, running every job twice)
FLASK_DEBUG=false
HOST=0.0.0.0
PORT=5000
# Max seconds an uploaded script may run before it is killed (with its
# whole process group)
SCRIPT_TIMEOUT=300
# Days of JobRun history to keep; 0 = keep forever. When > 0, old rows are
# deleted daily by the scheduler (and once at startup).
JOB_RUN_RETENTION_DAYS=0
# Login brute-force protection: failed attempts allowed per IP+username
# within LOGIN_WINDOW_SECONDS before a temporary lockout. 0 disables it.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
